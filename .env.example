# Copy to .env before running the desktop app.
API_BASE_URL=https://api.gekychat.com/api/v1

# Reverb (self-hosted) — must match server REVERB_* / BROADCAST_DRIVER=reverb
# Use WSS (443) in production. Plain WS on 8080 often fails from desktop networks.
REVERB_HOST=chat.gekychat.com
REVERB_PORT=443
REVERB_SCHEME=https
PUSHER_APP_KEY=gk-reverb-key-2024
PUSHER_HOST=chat.gekychat.com
PUSHER_WSS_PORT=443
PUSHER_FORCE_TLS=true
# Do not set PUSHER_WS_PORT unless you run plain WS locally.
PUSHER_AUTH_ENDPOINT=https://api.gekychat.com/api/v1/broadcasting/auth
